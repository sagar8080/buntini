{
  "name": "buntini",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test:speech": "node --test src/speech.test.ts",
    "test:pet": "node --test src/petLife.test.ts src/petWorld.test.ts src/thread.test.ts src/taskRecovery.test.ts src/setupSteps.test.ts src/markdown.test.ts src/themes.test.ts src/brain.test.ts",
    "test:worker": "python3 -m unittest discover -s worker/tests -v",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target",
    "build:audio": "bash native/build.sh",
    "build:fm": "bash native/build-fm.sh"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.6"
  }
}
