{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buntini",
  "version": "0.1.0",
  "identifier": "app.buntini.companion",
  "build": {
    "beforeDevCommand": "npm run build:audio && npm run build:fm && npm run dev",
    "beforeBuildCommand": "npm run build:audio && npm run build:fm && npm run build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main",
      "title": "Buntini",
      "width": 128,
      "height": 136,
      "minWidth": 128,
      "minHeight": 136,
      "backgroundColor": "#00000000",
      "transparent": true,
      "decorations": false,
      "shadow": false,
      "alwaysOnTop": true,
      "resizable": true,
      "visible": true,
      "focus": false,
      "acceptFirstMouse": true,
      "skipTaskbar": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {"../worker/": "worker/", "../native/": "native/"},
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
