{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buntini",
  "version": "0.3.0",
  "identifier": "app.buntini.companion",
  "build": {
    "beforeDevCommand": "npm run build:audio && npm run build:fm && npm run dev",
    "beforeBuildCommand": "npm run build:audio && npm run build:fm && npm run build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main",
      "create": false,
      "title": "Buntini",
      "width": 128,
      "height": 136,
      "minWidth": 128,
      "minHeight": 136,
      "backgroundColor": "#00000000",
      "transparent": true,
      "decorations": false,
      "shadow": false,
      "alwaysOnTop": true,
      "resizable": true,
      "visible": true,
      "focus": false,
      "acceptFirstMouse": true,
      "skipTaskbar": true
    }],
    "security": {
      "capabilities": ["main", "library"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../worker/__init__.py": "worker/__init__.py",
      "../worker/main.py": "worker/main.py",
      "../worker/protocol.py": "worker/protocol.py",
      "../worker/voice.py": "worker/voice.py",
      "../worker/tools.json": "worker/tools.json",
      "../models/bge-small-en-v1.5/config.json": "models/bge-small-en-v1.5/config.json",
      "../models/bge-small-en-v1.5/tokenizer.json": "models/bge-small-en-v1.5/tokenizer.json",
      "../models/bge-small-en-v1.5/model.safetensors": "models/bge-small-en-v1.5/model.safetensors",
      "../models/bge-small-en-v1.5/NOTICE": "models/bge-small-en-v1.5/NOTICE",
      "../native/intents/Metadata.appintents/extract.actionsdata": "Metadata.appintents/extract.actionsdata",
      "../native/intents/Metadata.appintents/version.json": "Metadata.appintents/version.json",
      "../native/intents/Localizable/ar.lproj/Localizable.strings": "ar.lproj/Localizable.strings",
      "../native/intents/Localizable/bn.lproj/Localizable.strings": "bn.lproj/Localizable.strings",
      "../native/intents/Localizable/de.lproj/Localizable.strings": "de.lproj/Localizable.strings",
      "../native/intents/Localizable/en.lproj/Localizable.strings": "en.lproj/Localizable.strings",
      "../native/intents/Localizable/es.lproj/Localizable.strings": "es.lproj/Localizable.strings",
      "../native/intents/Localizable/fr.lproj/Localizable.strings": "fr.lproj/Localizable.strings",
      "../native/intents/Localizable/hi.lproj/Localizable.strings": "hi.lproj/Localizable.strings",
      "../native/intents/Localizable/id.lproj/Localizable.strings": "id.lproj/Localizable.strings",
      "../native/intents/Localizable/ja.lproj/Localizable.strings": "ja.lproj/Localizable.strings",
      "../native/intents/Localizable/ko.lproj/Localizable.strings": "ko.lproj/Localizable.strings",
      "../native/intents/Localizable/pt-BR.lproj/Localizable.strings": "pt-BR.lproj/Localizable.strings",
      "../native/intents/Localizable/ru.lproj/Localizable.strings": "ru.lproj/Localizable.strings",
      "../native/intents/Localizable/th.lproj/Localizable.strings": "th.lproj/Localizable.strings",
      "../native/intents/Localizable/tr.lproj/Localizable.strings": "tr.lproj/Localizable.strings",
      "../native/intents/Localizable/zh-Hans.lproj/Localizable.strings": "zh-Hans.lproj/Localizable.strings",
      "../native/intents/Localizable/zh-Hant.lproj/Localizable.strings": "zh-Hant.lproj/Localizable.strings"
    },
    "externalBin": ["../native/buntini-audio", "../native/buntini-fm"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
