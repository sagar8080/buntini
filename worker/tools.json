{
  "search_files": {
    "name": "search_files",
    "description": "Search file names and indexed content within folders authorized by the user.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  "system_info": {
    "name": "system_info",
    "description": "Read a basic snapshot of this Mac's system and storage information.",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "web_search": {
    "name": "web_search",
    "description": "Search the live web. The controller requires the user's explicit online search intent.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  "weather": {
    "name": "weather",
    "description": "Current conditions and the 7-day forecast for a named place.",
    "parameters": {
      "type": "object",
      "properties": {
        "place": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "City or town, optionally with region or country"
        },
        "units": {
          "type": "string",
          "enum": [
            "celsius",
            "fahrenheit"
          ]
        }
      },
      "required": [
        "place"
      ],
      "additionalProperties": false
    }
  },
  "currency": {
    "name": "currency",
    "description": "Convert money using European Central Bank reference rates.",
    "parameters": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000000000000.0
        },
        "from": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "description": "ISO 4217 code, e.g. USD"
        },
        "to": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "description": "One or more ISO codes separated by commas"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    }
  },
  "wikipedia": {
    "name": "wikipedia",
    "description": "Look up an encyclopedia article summary about a person, place, thing or idea.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "language": {
          "type": "string",
          "enum": [
            "en",
            "de",
            "fr",
            "es",
            "it",
            "pt",
            "nl",
            "sv",
            "pl",
            "ru",
            "uk",
            "ja",
            "zh",
            "ko",
            "ar",
            "hi",
            "tr",
            "id"
          ]
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  "places": {
    "name": "places",
    "description": "Find nearby places of one kind around a street, district or city using OpenStreetMap.",
    "parameters": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "cafe",
            "restaurant",
            "bar",
            "pharmacy",
            "hospital",
            "atm",
            "bank",
            "supermarket",
            "bakery",
            "fuel",
            "charging_station",
            "parking",
            "hotel",
            "museum",
            "park",
            "library",
            "post_office",
            "gym",
            "toilets"
          ]
        },
        "near": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "radius_m": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000
        }
      },
      "required": [
        "category",
        "near"
      ],
      "additionalProperties": false
    }
  },
  "ebay_search": {
    "name": "ebay_search",
    "description": "Search live eBay listings to compare prices of an item.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "max_price": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 10000000
        },
        "condition": {
          "type": "string",
          "enum": [
            "any",
            "new",
            "used"
          ]
        },
        "sort": {
          "type": "string",
          "enum": [
            "best_match",
            "price",
            "newest"
          ]
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  "flight_search": {
    "name": "flight_search",
    "description": "Search flight offers between two airports or cities on given dates. Search only, never booking.",
    "parameters": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "IATA code like LIS, or a city name"
        },
        "destination": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "departure_date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "description": "YYYY-MM-DD"
        },
        "return_date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "description": "YYYY-MM-DD, only for return trips"
        },
        "adults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "cabin": {
          "type": "string",
          "enum": [
            "economy",
            "premium_economy",
            "business",
            "first"
          ]
        }
      },
      "required": [
        "origin",
        "destination",
        "departure_date"
      ],
      "additionalProperties": false
    }
  }
}
